# Kopiere diese Datei zu ".env" und trage deine echten Werte ein.
# Die .env Datei NIEMALS ins Git-Repo committen (enthaelt Secrets)!

# Typefully API-Key: https://typefully.com -> Settings -> Integrations -> API
TYPEFULLY_API_KEY=dein_typefully_api_key_hier

# Deine Social-Set-ID (bei CerberusFX: 322773)
TYPEFULLY_SOCIAL_SET_ID=322773

# Bot-Token von @BotFather in Telegram (Befehl: /newbot)
TELEGRAM_BOT_TOKEN=123456789:AAExxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Dein Kanal - bei oeffentlichen Kanaelen reicht der @-Handle.
# Wichtig: der Bot muss vorher als Admin in den Kanal eingeladen werden!
TELEGRAM_CHAT_ID=@CerberusFXTrading
